rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection: Each user can read/write ONLY their own profile/stats.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Drawings: Anyone authenticated can read; anyone can create; only author can update/delete.
    match /drawings/{drawingId} {
      // All users can read all drawings (to display game data)
      allow get, list: if request.auth != null;

      // Any authenticated user can add a drawing
      allow create: if request.auth != null;

      // Only the author can update/delete their drawing
      allow update, delete: if request.auth != null && request.resource.data.author_uid == request.auth.uid;
    }

    // Deny all other collections/documents by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
