rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Drawing images: allow upload and read to authenticated users only
    match /drawings/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Deny all other storage writes/reads by default
    match /{allOtherPaths=**} {
      allow read, write: if false;
    }
  }
}
